  @media (max-width: 900px) {
    padding: ${({ theme }) => `${theme.spacing.xxxl} ${theme.spacing.md}`};
    gap: 120px;
  }
`;

const RoleCard = styled.article<{ $reverse?: boolean }>`
  background: #FFFFFF;
  border-radius: 20px;
  width: 100%;
  max-width: 1050px;
  min-height: 260px;
  display: flex;
  flex-direction: ${({ $reverse }) => ($reverse ? 'row-reverse' : 'row')};
  align-items: stretch;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
  position: relative;
  /* Sem overflow: hidden para permitir o efeito out-of-bounds (imagem vazando) */

  @media (max-width: 900px) {
    flex-direction: column;
    align-items: center;
    padding-top: 140px; /* Espaço para a imagem no topo no mobile */
  }
`;

const RoleImageFrame = styled.div<{ $reverse?: boolean }>`
  width: 38%;
  min-width: 320px;
  background: linear-gradient(135deg, ${({ theme }) => theme.colors.emerald[60]} 0%, ${({ theme }) => theme.colors.blue[60]} 100%);
  /* Arredondamento severo para criar o padrão redondo solicitado */
  border-radius: 160px;
  position: relative;
  display: flex;
  justify-content: center;

  @media (max-width: 900px) {
    width: 100%;
    min-width: unset;
    height: 280px;
    border-radius: 100px;
    position: relative;
    margin-bottom: ${({ theme }) => theme.spacing.xl};
  }
`;

const ClippedInner = styled.div`
  position: absolute;
  inset: 0;
  border-radius: inherit; /* Herda o formato redondo do frame */
  overflow: hidden; /* Corta a imagem perfeitamente nas laterais e na base redonda */
  z-index: 1;
`;

const PopOutTopOnly = styled.div`
  position: absolute;
  inset: 0;
  z-index: 2;
  /* clip-path permite que vaze infinito pra cima, mas esconde a metade inferior da imagem 
     para que ela não cubra a borda redonda do ClippedInner */
  clip-path: inset(-150% 0 40% 0); 
`;

const PopOutImage = styled.img`
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 90%; /* Deixa uma margem do gradiente visível nas laterais */
  height: 125%; /* Altura suficiente para vazar a cabeça por cima */
  object-fit: cover;
  object-position: top center;
  display: block;
`;

